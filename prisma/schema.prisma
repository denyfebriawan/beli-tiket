// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ORGANIZER
  BUYER
}

enum DropStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  SOLD_OUT
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  role          Role     @default(BUYER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  drops    Drop[]
  orders   Order[]
  sessions Session[]
  accounts Account[]

  // Better Auth's Prisma adapter looks up its tables by lowercase name
  // (information_schema is case-sensitive, and Postgres preserves whatever
  // case Prisma quotes a table with) — @@map keeps this table matching that
  // convention while our own domain tables (Drop/Ticket/Order) stay PascalCase.
  @@map("user")
}

// Better Auth's required tables (session/account/verification): Better Auth
// generates its own ids and always supplies them explicitly on create, so
// unlike our own models these don't need a Prisma @default for id.

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Credential-provider password hash lives here (not on User) — this is
  // where Better Auth's email/password plugin actually stores it.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// QueueEntry (the virtual waiting room) is deliberately not modeled here —
// per PLANNING.md it's high-churn/ephemeral and belongs in Redis, added
// alongside BullMQ later in the build order, not as a Postgres table.

model Drop {
  id            String     @id @default(cuid())
  organizerId   String
  name          String
  description   String
  price         Decimal    @db.Decimal(10, 2)
  totalQuantity Int
  startsAt      DateTime
  status        DropStatus @default(DRAFT)

  organizer User     @relation(fields: [organizerId], references: [id])
  tickets   Ticket[]
  orders    Order[]

  @@index([organizerId])
}

model Ticket {
  id      String       @id @default(cuid())
  dropId  String
  status  TicketStatus @default(AVAILABLE)
  orderId String?

  drop  Drop   @relation(fields: [dropId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  // Backs the "grab any one available ticket for this drop" query —
  // the SELECT ... FOR UPDATE SKIP LOCKED target from PLANNING.md.
  @@index([dropId, status])
}

model Order {
  id             String      @id @default(cuid())
  buyerId        String
  dropId         String
  idempotencyKey String      @unique
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @db.Decimal(10, 2)

  buyer   User     @relation(fields: [buyerId], references: [id])
  drop    Drop     @relation(fields: [dropId], references: [id])
  tickets Ticket[]

  @@index([buyerId])
  @@index([dropId])
}
