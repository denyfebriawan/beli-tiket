// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ORGANIZER
  BUYER
}

enum DropStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  SOLD_OUT
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(BUYER)
  createdAt    DateTime @default(now())

  drops  Drop[]
  orders Order[]
}

// QueueEntry (the virtual waiting room) is deliberately not modeled here —
// per PLANNING.md it's high-churn/ephemeral and belongs in Redis, added
// alongside BullMQ later in the build order, not as a Postgres table.

model Drop {
  id            String     @id @default(cuid())
  organizerId   String
  name          String
  description   String
  price         Decimal    @db.Decimal(10, 2)
  totalQuantity Int
  startsAt      DateTime
  status        DropStatus @default(DRAFT)

  organizer User     @relation(fields: [organizerId], references: [id])
  tickets   Ticket[]
  orders    Order[]

  @@index([organizerId])
}

model Ticket {
  id      String       @id @default(cuid())
  dropId  String
  status  TicketStatus @default(AVAILABLE)
  orderId String?

  drop  Drop   @relation(fields: [dropId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])

  // Backs the "grab any one available ticket for this drop" query —
  // the SELECT ... FOR UPDATE SKIP LOCKED target from PLANNING.md.
  @@index([dropId, status])
}

model Order {
  id             String      @id @default(cuid())
  buyerId        String
  dropId         String
  idempotencyKey String      @unique
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @db.Decimal(10, 2)

  buyer   User     @relation(fields: [buyerId], references: [id])
  drop    Drop     @relation(fields: [dropId], references: [id])
  tickets Ticket[]

  @@index([buyerId])
  @@index([dropId])
}
